// Shared settings for all environments (Dev / Beta / Release)
MACOSX_DEPLOYMENT_TARGET = 26.0
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 1

DEVELOPMENT_TEAM = 63MSW5QTJL
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development

// Developer ID distribution: no sandbox, hardened runtime for notarization
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 YouMindHub

// Workflows: AppleScript steps / Empty Trash send Apple Events (hardened runtime needs the entitlement)
CODE_SIGN_ENTITLEMENTS = Config/AppPad.entitlements
INFOPLIST_KEY_NSAppleEventsUsageDescription = AppPad workflows control the apps you allow, for example Finder to empty the Trash.

// Workflow Market links: apppad://import-workflow?url=… (Dev overrides the scheme).
// Config/Info.plist only adds CFBundleURLTypes; everything else stays generated. Not a target member.
INFOPLIST_FILE = Config/Info.plist
APP_URL_SCHEME = apppad
