    "Name and Description above are English, the default language. Empty translated fields fall back to English. Keywords of the current language and the English ones both work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name und Beschreibung oben sind Englisch, die Standardsprache. Leere übersetzte Felder verwenden Englisch. Schlüsselwörter der aktuellen Sprache und die englischen funktionieren beide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre y la descripción de arriba están en inglés, el idioma predeterminado. Los campos traducidos vacíos usan el inglés. Funcionan las palabras clave del idioma actual y las inglesas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom et la description ci-dessus sont en anglais, la langue par défaut. Les champs traduits vides utilisent l’anglais. Les mots-clés de la langue actuelle et ceux en anglais fonctionnent tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome e la descrizione sopra sono in inglese, la lingua predefinita. I campi tradotti vuoti usano l’inglese. Funzionano sia le parole chiave della lingua attuale sia quelle inglesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上の名前と説明は英語（デフォルトの言語）です。翻訳が空の項目には英語が使われます。キーワードは現在の言語と英語の両方が使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 이름과 설명은 기본 언어인 영어입니다. 번역이 비어 있는 항목은 영어로 표시됩니다. 키워드는 현재 언어와 영어 모두 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De naam en beschrijving hierboven zijn Engels, de standaardtaal. Lege vertaalde velden gebruiken Engels. Trefwoorden in de huidige taal en de Engelse werken allebei."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上方的名称和描述为英文（默认语言）。译文留空的字段将使用英文。当前语言的关键字和英文关键字都可以触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上方的名稱和描述為英文（預設語言）。譯文留空的欄位將使用英文。目前語言的關鍵字和英文關鍵字都可以觸發。"
          }
        }
      }
    },
    "Needs Accessibility permission to move and resize windows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert die Berechtigung „Bedienungshilfen“, um Fenster zu bewegen und ihre Größe zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere permiso de Accesibilidad para mover y redimensionar ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite l’autorisation d’accessibilité pour déplacer et redimensionner les fenêtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede il permesso di Accessibilità per spostare e ridimensionare le finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを移動・サイズ変更するにはアクセシビリティの許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 이동하고 크기를 조절하려면 손쉬운 사용 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist toestemming voor Toegankelijkheid om vensters te verplaatsen en van grootte te veranderen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要“辅助功能”权限才能移动和调整窗口大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要「輔助使用」權限才能移動和調整視窗大小。"
          }
        }
      }
    },
    "Needs Accessibility permission; until then items are only copied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert die Berechtigung „Bedienungshilfen“; bis dahin werden Objekte nur kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere permiso de Accesibilidad; hasta entonces, los elementos solo se copian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite l’autorisation d’accessibilité ; d’ici là, les éléments sont seulement copiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede il permesso di Accessibilità; fino ad allora gli elementi vengono solo copiati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティの許可が必要です。許可されるまでは項目のコピーのみ行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 권한이 필요합니다. 그 전까지는 항목이 복사만 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist toestemming voor Toegankelijkheid; tot die tijd worden onderdelen alleen gekopieerd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要“辅助功能”权限；在授权前只会拷贝项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要「輔助使用」權限；在授權之前只會拷貝項目。"
          }
        }
      }
    },
