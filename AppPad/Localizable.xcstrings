    "Needs Accessibility permission to move and resize windows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert die Berechtigung „Bedienungshilfen“, um Fenster zu bewegen und ihre Größe zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere permiso de Accesibilidad para mover y redimensionar ventanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite l’autorisation d’accessibilité pour déplacer et redimensionner les fenêtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede il permesso di Accessibilità per spostare e ridimensionare le finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを移動・サイズ変更するにはアクセシビリティの許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 이동하고 크기를 조절하려면 손쉬운 사용 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist toestemming voor Toegankelijkheid om vensters te verplaatsen en van grootte te veranderen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要“辅助功能”权限才能移动和调整窗口大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要「輔助使用」權限才能移動和調整視窗大小。"
          }
        }
      }
    },
    "Needs Accessibility permission; until then items are only copied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert die Berechtigung „Bedienungshilfen“; bis dahin werden Objekte nur kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere permiso de Accesibilidad; hasta entonces, los elementos solo se copian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite l’autorisation d’accessibilité ; d’ici là, les éléments sont seulement copiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede il permesso di Accessibilità; fino ad allora gli elementi vengono solo copiati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティの許可が必要です。許可されるまでは項目のコピーのみ行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 권한이 필요합니다. 그 전까지는 항목이 복사만 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist toestemming voor Toegankelijkheid; tot die tijd worden onderdelen alleen gekopieerd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要“辅助功能”权限；在授权前只会拷贝项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要「輔助使用」權限；在授權之前只會拷貝項目。"
          }
        }
      }
    },
