    "%@. Saved items are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Gesicherte Objekte bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Los elementos guardados se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Les éléments enregistrés sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Gli elementi salvati vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。保存済み項目は残ります。"
