    "System Settings › Keyboard › Keyboard Shortcuts › Spotlight: turn off “Show Spotlight search” or give it another shortcut." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemeinstellungen › Tastatur › Tastaturkurzbefehle › Spotlight: Deaktiviere „Spotlight-Suche anzeigen“ oder gib ihr einen anderen Kurzbefehl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes del Sistema › Teclado › Funciones rápidas de teclado › Spotlight: desactiva “Mostrar búsqueda de Spotlight” o asígnale otro atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages Système › Clavier › Raccourcis clavier › Spotlight : désactivez « Afficher la recherche Spotlight » ou attribuez-lui un autre raccourci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni di Sistema › Tastiera › Abbreviazioni da tastiera › Spotlight: disattiva “Mostra ricerca Spotlight” o assegnale un’altra abbreviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 › キーボード › キーボードショートカット › Spotlight で「Spotlight検索を表示」をオフにするか、別のショートカットを割り当ててください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 키보드 › 키보드 단축키 › Spotlight에서 'Spotlight 검색 보기'를 끄거나 다른 단축키를 지정하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeeminstellingen › Toetsenbord › Toetscombinaties › Spotlight: zet ‘Toon Spotlight-zoekveld’ uit of geef het een andere sneltoets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“系统设置” › “键盘” › “键盘快捷键” › “聚焦”：关闭“显示‘聚焦’搜索”，或为其指定其他快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「系統設定」›「鍵盤」›「鍵盤快速鍵」›「Spotlight」：關閉「顯示 Spotlight 搜尋」，或為其指定其他快速鍵。"
          }
        }
      }
    },
