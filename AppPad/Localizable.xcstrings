    "Sent to the shortcut. Empty = the step input; {{input}} inserts it, \\n starts a new line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird an den Kurzbefehl gesendet. Leer = Eingabe des Schritts; {{input}} fügt sie ein, \\n beginnt eine neue Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía al atajo. Vacío = la entrada del paso; {{input}} la inserta y \\n empieza una línea nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé au raccourci. Vide = l’entrée de l’étape ; {{input}} l’insère, \\n commence une nouvelle ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato al comando rapido. Vuoto = l’input del passo; {{input}} lo inserisce, \\n inizia una nuova riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットに渡されます。空欄の場合はステップの入力。{{input}} で入力を挿入、\\n で改行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축어에 전달됩니다. 비워 두면 단계 입력을 사용하며, {{input}}은 입력을 삽입하고 \\n은 줄을 바꿉니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt naar de opdracht gestuurd. Leeg = de invoer van de stap; {{input}} voegt die in, \\n begint een nieuwe regel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送给快捷指令的内容。留空则使用该步骤的输入；{{input}} 插入输入，\\n 表示换行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送給捷徑的內容。留空則使用該步驟的輸入；{{input}} 插入輸入，\\n 表示換行。"
          }
        }
      }
    },
    "Separate keywords with commas or spaces. An exact keyword ranks the workflow first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenne Schlüsselwörter mit Kommas oder Leerzeichen. Ein exakt passendes Schlüsselwort setzt den Workflow an die erste Stelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa las palabras clave con comas o espacios. Una palabra clave exacta pone el flujo de trabajo en primer lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparez les mots-clés par des virgules ou des espaces. Un mot-clé exact place le workflow en premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separa le parole chiave con virgole o spazi. Una parola chiave esatta mette il workflow al primo posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーワードはカンマまたはスペースで区切ります。キーワードに完全一致するとワークフローが先頭に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드는 쉼표나 공백으로 구분합니다. 키워드와 정확히 일치하면 워크플로가 맨 위에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheid trefwoorden met komma’s of spaties. Een exact trefwoord zet de workflow bovenaan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多个关键字用逗号或空格分隔。与任一关键字完全一致时，该工作流排在第一位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
