    "Works on the focused window of the frontmost app. Click a field to record, Delete clears, Esc cancels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für das aktive Fenster der vordersten App. Klicke auf ein Feld zum Aufnehmen, Rückschritt löscht, Esc bricht ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actúa sobre la ventana activa de la app en primer plano. Haz clic en un campo para grabar; Eliminar lo borra y Esc cancela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à la fenêtre active de l’app au premier plan. Cliquez sur un champ pour enregistrer, Supprimer efface, Échap annule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agisce sulla finestra attiva dell’app in primo piano. Fai clic su un campo per registrare, Elimina cancella, Esc annulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最前面のアプリのアクティブなウインドウに適用されます。フィールドをクリックで記録、Delete で消去、Esc でキャンセル。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 앞에 있는 앱의 활성 윈도우에 적용됩니다. 필드를 클릭하여 기록하고, Delete로 지우고, Esc로 취소합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt op het actieve venster van de voorste app. Klik op een veld om op te nemen, Delete wist, Esc annuleert."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用于最前方 App 的当前窗口。点按字段以录制，按 Delete 清除，按 Esc 取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作用於最前方 App 的目前視窗。按一下欄位以錄製，按 Delete 清除，按 Esc 取消。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}