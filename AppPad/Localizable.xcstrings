    "Add this to the client's MCP configuration (Claude Desktop: claude_desktop_config.json), then restart the client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge dies der MCP-Konfiguration des Clients hinzu (Claude Desktop: claude_desktop_config.json) und starte den Client neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade esto a la configuración MCP del cliente (Claude Desktop: claude_desktop_config.json) y reinicia el cliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez ceci à la configuration MCP du client (Claude Desktop : claude_desktop_config.json), puis redémarrez le client."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi questo alla configurazione MCP del client (Claude Desktop: claude_desktop_config.json), quindi riavvia il client."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これをクライアントの MCP 設定（Claude Desktop：claude_desktop_config.json）に追加し、クライアントを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 내용을 클라이언트의 MCP 설정(Claude Desktop: claude_desktop_config.json)에 추가한 다음 클라이언트를 다시 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg dit toe aan de MCP-configuratie van de client (Claude Desktop: claude_desktop_config.json) en start de client opnieuw."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此内容添加到客户端的 MCP 配置中（Claude Desktop：claude_desktop_config.json），然后重新启动客户端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此內容加入用戶端的 MCP 設定中（Claude Desktop：claude_desktop_config.json），然後重新啟動用戶端。"
          }
        }
      }
    },
