    "Applies to AppPad, Clipboard and Workflows. When off, they open on the main display." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für AppPad, Zwischenablage und Workflows. Wenn deaktiviert, werden sie auf dem Hauptbildschirm geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a AppPad, Portapapeles y Flujos de trabajo. Si está desactivado, se abren en la pantalla principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à AppPad, au Presse-papiers et aux Flux de travail. Si désactivé, ils s’ouvrent sur l’écran principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica ad AppPad, Appunti e Flussi di lavoro. Se disattivato, si aprono sullo schermo principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppPad、クリップボード、ワークフローに適用されます。オフの場合はメインディスプレイで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppPad, 클립보드, 워크플로에 적용됩니다. 끄면 주 디스플레이에서 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt voor AppPad, Klembord en Workflows. Indien uit, openen ze op het hoofdscherm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 AppPad、剪贴板和工作流。关闭后，它们都会在主显示器上打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於 AppPad、剪貼簿和工作流程。關閉後，它們都會在主顯示器上打開。"
          }
        }
      }
    },
    "Open on the display with the pointer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Bildschirm mit dem Zeiger öffnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir en la pantalla donde está el puntero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir sur l’écran où se trouve le pointeur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri sullo schermo in cui si trova il puntatore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタのあるディスプレイで開く"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 있는 디스플레이에서 열기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Openen op het scherm met de aanwijzer"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在鼠标所在的显示器上打开"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在滑鼠所在的顯示器上打開"
          }
        }
      }
    },
    "{{input}} is replaced by the argument (URL-encoded)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} wird durch das Argument ersetzt (URL-kodiert)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} se sustituye por el argumento (codificado para URL)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} est remplacé par l’argument (encodé pour l’URL)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} viene sostituito dall’argomento (codificato per URL)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} は引数（URL エンコード済み）に置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}}은 인수(URL 인코딩)로 대치됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} wordt vervangen door het argument (URL-gecodeerd)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} 会被替换为参数（已进行 URL 编码）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} 會被取代為參數（已進行 URL 編碼）。"
          }
        }
      }
    },
    "{{output}} is replaced by the final output, {{error}} by the error. Runs started from Settings show the result window instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} wird durch die endgültige Ausgabe ersetzt, {{error}} durch den Fehler. Bei Ausführung aus den Einstellungen erscheint stattdessen das Ergebnisfenster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} se sustituye por la salida final y {{error}} por el error. Las ejecuciones iniciadas desde Ajustes muestran la ventana de resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} est remplacé par la sortie finale, {{error}} par l’erreur. Les exécutions lancées depuis les Réglages affichent plutôt la fenêtre de résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} viene sostituito dall’output finale, {{error}} dall’errore. Le esecuzioni avviate dalle Impostazioni mostrano invece la finestra dei risultati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} は最終出力に、{{error}} はエラーに置き換えられます。設定から実行した場合は、代わりに結果ウインドウが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}}은 최종 출력으로, {{error}}는 오류로 대체됩니다. 설정에서 실행하면 대신 결과 윈도우가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} wordt vervangen door de uiteindelijke uitvoer, {{error}} door de fout. Bij uitvoeren vanuit Instellingen verschijnt in plaats daarvan het resultaatvenster."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} 会替换为最终输出，{{error}} 会替换为错误信息。从设置中运行时会改为显示结果窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} 會取代為最終輸出，{{error}} 會取代為錯誤訊息。從設定中執行時會改為顯示結果視窗。"
          }
        }
      }
    },
