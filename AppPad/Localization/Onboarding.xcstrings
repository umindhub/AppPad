    "Workflows has no global shortcut. You can set one in Settings › Workflows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workflows hat keinen globalen Kurzbefehl. Du kannst einen unter Einstellungen › Workflows festlegen."
          }
        },
        "es" : {
          "stringUnit" : {
