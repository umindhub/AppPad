    "macOS gives %@ to Spotlight by default. Turn off Spotlight's shortcut to use it for AppPad Workflows instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS weist %@ standardmäßig Spotlight zu. Deaktiviere den Spotlight-Kurzbefehl, um ihn stattdessen für AppPad-Workflows zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS asigna %@ a Spotlight de forma predeterminada. Desactiva el atajo de Spotlight para usarlo con los flujos de trabajo de AppPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, macOS attribue %@ à Spotlight. Désactivez le raccourci de Spotlight pour l’utiliser avec les flux de travail d’AppPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita macOS assegna %@ a Spotlight. Disattiva l’abbreviazione di Spotlight per usarla con i flussi di lavoro di AppPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS では %@ がデフォルトで Spotlight に割り当てられています。Spotlight のショートカットをオフにすると、AppPad のワークフローに使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS는 기본적으로 %@을(를) Spotlight에 할당합니다. Spotlight 단축키를 끄면 AppPad 워크플로에 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS wijst %@ standaard toe aan Spotlight. Zet de Spotlight-sneltoets uit om hem voor AppPad-workflows te gebruiken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 默认将 %@ 分配给“聚焦”。关闭“聚焦”的快捷键，即可将它用于 AppPad 工作流。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 預設將 %@ 指定給 Spotlight。關閉 Spotlight 的快速鍵，即可將它用於 AppPad 工作流程。"
          }
        }
      }
    },
