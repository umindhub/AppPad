        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누르면 앱이 열리거나 앱으로 전환되고, 다시 누르면 가려집니다. 어디서든 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk erop om de app te openen of ernaar te wisselen, en druk nog eens om hem te verbergen. Het werkt overal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下打开或切换到该 App，再按一下即可隐藏。在任何地方都能用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下打開或切換到該 App，再按一下即可隱藏。在任何地方都能用。"
