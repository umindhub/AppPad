    "Add more in Settings › App Shortcuts, or choose Set Shortcut… on an app in AppPad." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere fügst du unter Einstellungen › App-Kurzbefehle hinzu oder wählst bei einer App in AppPad „Kurzbefehl festlegen …“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade más en Ajustes › Atajos de apps, o elige Definir atajo… en una app de AppPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez-en d’autres dans Réglages › Raccourcis d’apps, ou choisissez Définir un raccourci… sur une app dans AppPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungine altre in Impostazioni › Abbreviazioni app, oppure scegli Imposta abbreviazione… su un’app in AppPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」›「アプリのショートカット」で追加するか、AppPad でアプリの「ショートカットを設定…」を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 앱 단축키에서 추가하거나, AppPad에서 앱의 단축키 설정…을 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg er meer toe via Instellingen › App-sneltoetsen, of kies ‘Stel sneltoets in…’ bij een app in AppPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以在“设置”›“App 快捷键”中添加更多，或在 AppPad 中对 App 选择“设置快捷键…”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以在「設定」›「App 快速鍵」中加入更多，或在 AppPad 中對 App 選擇「設定快速鍵⋯」。"
          }
        }
      }
    },
    "All your apps in a Launchpad-style grid with folders, search and drag and drop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Apps in einem Raster wie bei Launchpad, mit Ordnern, Suche und Drag & Drop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas tus apps en una cuadrícula al estilo Launchpad, con carpetas, búsqueda y arrastrar y soltar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes vos apps dans une grille façon Launchpad, avec dossiers, recherche et glisser-déposer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le tue app in una griglia stile Launchpad, con cartelle, ricerca e trascinamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアプリを Launchpad 風のグリッドに。フォルダ、検索、ドラッグ&ドロップに対応。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 앱을 Launchpad 스타일 격자로. 폴더, 검색, 드래그 앤 드롭을 지원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al je apps in een raster zoals Launchpad, met mappen, zoeken en slepen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 App 以启动台风格的网格排列，支持文件夹、搜索和拖放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 App 以啟動台風格的格狀排列，支援檔案夾、搜尋和拖放。"
          }
        }
      }
    },
