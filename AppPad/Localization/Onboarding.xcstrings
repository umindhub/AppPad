    "Pinch with thumb and three fingers to open AppPad and spread them to close it, just like Launchpad." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe Daumen und drei Finger zusammen, um AppPad zu öffnen, und spreize sie zum Schließen – genau wie bei Launchpad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta el pulgar y tres dedos para abrir AppPad y sepáralos para cerrarlo, igual que Launchpad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez avec le pouce et trois doigts pour ouvrir AppPad, écartez-les pour le fermer, comme avec Launchpad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica con il pollice e tre dita per aprire AppPad e allargale per chiuderlo, proprio come Launchpad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親指と 3 本指でピンチすると AppPad が開き、広げると閉じます。Launchpad と同じ操作です。"
          }
        },
        "ko" : {
          "stringUnit" : {
