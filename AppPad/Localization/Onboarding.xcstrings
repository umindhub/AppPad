          }
        }
      }
    },
    "Plus clipboard history, workflows, window control and app shortcuts — all from the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dazu Zwischenablage-Verlauf, Workflows, Fenstersteuerung und App-Kurzbefehle – alles über die Menüleiste."
          }
        },
        "es" : {
          "stringUnit" : {
