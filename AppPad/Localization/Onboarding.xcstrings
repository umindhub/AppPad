    "Built for Mac: the fast, authentic Launchpad, just like in macOS 15." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den Mac gemacht: das schnelle, originalgetreue Launchpad – genau wie in macOS 15."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creado para Mac: el Launchpad rápido y auténtico, igual que en macOS 15."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conçu pour le Mac : le Launchpad rapide et authentique, comme dans macOS 15."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creato per Mac: il Launchpad veloce e autentico, proprio come in macOS 15."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac のために作られた、本物そのままの高速な Launchpad。macOS 15 と同じ使い心地です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac을 위해 만든, 오리지널 그대로의 빠른 Launchpad. macOS 15와 똑같습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemaakt voor de Mac: het snelle, echte Launchpad, net als in macOS 15."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 Mac 打造，原汁原味的快速启动台，就像 macOS 15 一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為 Mac 打造，原汁原味的快速啟動台，就像 macOS 15 一樣。"
          }
        }
      }
    },
    "Click the Safari icon to show only items copied from Safari" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf das Safari-Symbol, um nur aus Safari kopierte Objekte zu sehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el icono de Safari para ver solo lo copiado desde Safari"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur l’icône de Safari pour n’afficher que les éléments copiés depuis Safari"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic sull’icona di Safari per vedere solo gli elementi copiati da Safari"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari のアイコンをクリックすると、Safari からコピーした項目だけを表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari 아이콘을 클릭하면 Safari에서 복사한 항목만 표시"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op het Safari-symbool om alleen onderdelen uit Safari te tonen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击 Safari 图标，只显示从 Safari 复制的项目"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下 Safari 圖像，只顯示從 Safari 拷貝的項目"
          }
        }
      }
    },
