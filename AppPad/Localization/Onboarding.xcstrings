    "Tidy up my AppPad: keep the system apps in their current order, and put third-party apps into folders by category after them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räum mein AppPad auf: System-Apps bleiben in ihrer jetzigen Reihenfolge, Apps von Drittanbietern kommen nach Kategorie in Ordner dahinter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordena mi AppPad: deja las apps del sistema en su orden actual y pon las apps de terceros en carpetas por categoría después de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
