    "No app shortcuts yet. Click a field below to record one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine App-Kurzbefehle. Klicke unten auf ein Feld, um einen aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay atajos de apps. Haz clic en un campo de abajo para grabar uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun raccourci d’app pour l’instant. Cliquez sur un champ ci-dessous pour en enregistrer un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessuna abbreviazione app. Fai clic su un campo qui sotto per registrarne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのショートカットはまだありません。下のフィールドをクリックして記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 앱 단축키가 없습니다. 아래 필드를 클릭하여 기록하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen app-sneltoetsen. Klik hieronder op een veld om er een op te nemen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有 App 快捷键。点按下方的字段即可录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未設定 App 快速鍵。按一下下方的欄位即可錄製。"
          }
        }
      }
    },
