    "Back to the size and position before snapping" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück zu Größe und Position vor dem Andocken"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve al tamaño y la posición anteriores al ajuste"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenir à la taille et à la position d’avant l’ancrage"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna alle dimensioni e alla posizione precedenti"
