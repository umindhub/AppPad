  "strings" : {
    "All pages and folders will be rearranged in the default order." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Seiten und Ordner werden in der Standardreihenfolge neu angeordnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las páginas y carpetas se reorganizarán en el orden predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les pages et tous les dossiers seront réorganisés dans l’ordre par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le pagine e le cartelle verranno riordinate secondo l’ordine predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのページとフォルダがデフォルトの順序に並べ替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 페이지와 폴더가 기본 순서로 재배열됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle pagina’s en mappen worden in de standaardvolgorde gezet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有页面和文件夹都将按默认顺序重新排列。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有頁面和檔案夾都會依預設順序重新排列。"
          }
        }
      }
    },
