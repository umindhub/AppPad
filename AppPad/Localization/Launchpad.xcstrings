          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuche es erneut. Zum Löschen ist eventuell ein Administratorpasswort erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo. Es posible que se necesite una contraseña de administrador para eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayez. Sa suppression peut nécessiter un mot de passe administrateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprova. Per eliminarla potrebbe essere necessaria una password di amministratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度お試しください。削除には管理者パスワードが必要な場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 시도하십시오. 삭제하려면 관리자 암호가 필요할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
