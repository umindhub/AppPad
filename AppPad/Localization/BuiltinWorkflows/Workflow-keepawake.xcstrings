    "Keep the Mac awake; without a duration until you stop it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält den Mac wach; ohne Dauer, bis du stoppst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene el Mac activo; sin duración, hasta que lo detengas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le Mac éveillé ; sans durée, jusqu’à ce que vous l’arrêtiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene attivo il Mac; senza durata, finché non lo interrompi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac をスリープさせません。時間を指定しない場合は停止するまで続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 잠자기 상태로 전환되지 않게 합니다. 시간을 지정하지 않으면 중지할 때까지 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt de Mac wakker; zonder duur tot je stopt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持 Mac 唤醒；不填时长则一直保持，直到手动停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持 Mac 喚醒；不填時長則一直保持，直到手動停止。"
          }
        }
      }
    }
