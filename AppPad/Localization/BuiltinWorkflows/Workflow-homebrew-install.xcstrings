        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 공식 설치 명령이 입력된 터미널을 엽니다. Return 키를 누르면 시작됩니다. AI 어시스턴트는 Homebrew로 앱을 설치합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent Terminal met de officiële installatieopdracht van Homebrew al ingevuld; druk op Return om te beginnen. AI-assistenten installeren apps met Homebrew."
