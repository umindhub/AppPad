          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Gli elementi salvati vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。保存済み項目は残ります。"
