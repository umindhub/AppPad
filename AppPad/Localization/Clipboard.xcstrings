    "%@. Saved items are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Gesicherte Objekte bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Los elementos guardados se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
