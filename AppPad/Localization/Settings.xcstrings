    "Applies to AppPad, Clipboard and Workflows. When off, they open on the main display." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für AppPad, Zwischenablage und Workflows. Wenn deaktiviert, werden sie auf dem Hauptbildschirm geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a AppPad, Portapapeles y Flujos de trabajo. Si está desactivado, se abren en la pantalla principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à AppPad, au Presse-papiers et aux Flux de travail. Si désactivé, ils s’ouvrent sur l’écran principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica ad AppPad, Appunti e Flussi di lavoro. Se disattivato, si aprono sullo schermo principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppPad、クリップボード、ワークフローに適用されます。オフの場合はメインディスプレイで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppPad, 클립보드, 워크플로에 적용됩니다. 끄면 주 디스플레이에서 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
