    "The AppPad layout is always replaced. Apps not installed on this Mac are skipped; apps missing from the backup are added at the end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das AppPad-Layout wird immer ersetzt. Nicht auf diesem Mac installierte Apps werden übersprungen; Apps, die im Backup fehlen, werden am Ende hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposición de AppPad siempre se sustituye. Las apps que no estén instaladas en este Mac se omiten; las que falten en la copia se añaden al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition d’AppPad est toujours remplacée. Les apps non installées sur ce Mac sont ignorées ; celles absentes de la sauvegarde sont ajoutées à la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il layout di AppPad viene sempre sostituito. Le app non installate su questo Mac vengono ignorate; quelle assenti dal backup vengono aggiunte alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppPad のレイアウトは常に置き換えられます。この Mac にインストールされていないアプリはスキップされ、バックアップにないアプリは最後に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppPad 레이아웃은 항상 대치됩니다. 이 Mac에 설치되지 않은 앱은 건너뛰며, 백업에 없는 앱은 끝에 추가됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AppPad-indeling wordt altijd vervangen. Apps die niet op deze Mac zijn geïnstalleerd worden overgeslagen; apps die niet in de reservekopie staan worden achteraan toegevoegd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppPad 布局总是会被替换。此 Mac 上未安装的 App 会被跳过；备份中没有的 App 会添加到末尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppPad 佈局一律會被取代。此 Mac 上未安裝的 App 會被略過；備份中沒有的 App 會加入到最後。"
          }
        }
      }
    },
