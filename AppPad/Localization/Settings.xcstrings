    "Above %@ transparency the open windows behind show through, blurred by the Blur value." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab einer Transparenz über %@ scheinen die geöffneten Fenster dahinter durch, unscharf gemäß dem Unschärfewert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una transparencia superior al %@ se ven las ventanas abiertas detrás, desenfocadas según el valor de desenfoque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de %@ de transparence, les fenêtres ouvertes derrière transparaissent, floutées selon la valeur de flou."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una trasparenza superiore allo %@ si vedono le finestre aperte dietro, sfocate secondo il valore di sfocatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透明度が %@ より大きいときは、後ろの開いているウインドウが透けて見え、ぼかしの値でぼかされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "투명도가 %@보다 크면 뒤에 열린 윈도우가 비쳐 보이며 흐림 값만큼 흐려집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boven %@ transparantie schijnen de geopende vensters erachter door, vervaagd volgens de vervagingswaarde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透明度大于 %@ 时会透出后面已打开的窗口，并按模糊度进行模糊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透明度大於 %@ 時會透出後面已打開的視窗，並按模糊度進行模糊。"
          }
        }
      }
    },
