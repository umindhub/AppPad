    "Auto follows the macOS appearance. AppPad, Clipboard and Workflows backgrounds follow the theme." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ folgt der macOS-Darstellung. Die Hintergründe von AppPad, Zwischenablage und Workflows folgen dem Design."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático sigue la apariencia de macOS. Los fondos de AppPad, Portapapeles y Flujos de trabajo siguen el tema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique suit l’apparence de macOS. Les arrière-plans d’AppPad, du Presse-papiers et des Flux de travail suivent le thème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico segue l’aspetto di macOS. Gli sfondi di AppPad, Appunti e Flussi di lavoro seguono il tema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」は macOS の外観に従います。AppPad、クリップボード、ワークフローの背景もテーマに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 macOS 화면 모드를 따릅니다. AppPad, 클립보드, 워크플로의 배경도 테마를 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch volgt de macOS-weergave. De achtergronden van AppPad, Klembord en Workflows volgen het thema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动跟随 macOS 外观。AppPad、剪切板和工作流的背景会跟随主题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動跟隨 macOS 外觀。AppPad、剪貼簿和工作流程的背景會跟隨主題。"
          }
        }
      }
    },
