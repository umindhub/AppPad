    "macOS hot corners also use: %@. Both run when the pointer reaches that corner." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch die aktiven Ecken von macOS nutzen: %@. Erreicht der Zeiger diese Ecke, wird beides ausgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las esquinas activas de macOS también usan: %@. Cuando el puntero llega a esa esquina, se ejecutan ambas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coins actifs de macOS utilisent aussi : %@. Les deux s’exécutent lorsque le pointeur atteint ce coin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche gli angoli attivi di macOS usano: %@. Quando il puntatore raggiunge quell’angolo vengono eseguiti entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS のホットコーナーにも設定されています：%@。ポインタがその隅に来ると両方が実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 핫 코너에도 설정되어 있습니다: %@. 포인터가 그 모서리에 닿으면 둘 다 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De actieve hoeken van macOS gebruiken ook: %@. Als de aanwijzer die hoek bereikt, worden beide uitgevoerd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统触发角也设置了：%@。指针到达该角时两者会同时触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統熱點也設定了：%@。指標到達該角時兩者會同時觸發。"
          }
        }
      }
    },
