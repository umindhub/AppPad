    "Notification Center and Quick Note need Accessibility permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungszentrale und Schnellnotiz benötigen die Berechtigung für Bedienungshilfen."
