    "Scripts may connect anywhere (curl, git, gh…)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte dürfen sich überallhin verbinden (curl, git, gh …)."
