      }
    },
    "The ID is unique. Importing a workflow with the same ID and a higher version replaces this one; the icon URL is downloaded and stored with the ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ID ist eindeutig. Ein importierter Workflow mit derselben ID und einer höheren Version ersetzt diesen; die Symbol-URL wird geladen und unter der ID gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ID es único. Al importar un flujo de trabajo con el mismo ID y una versión superior, este se reemplaza; la URL del icono se descarga y se guarda con el ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identifiant est unique. Importer un workflow ayant le même identifiant et une version supérieure remplace celui-ci ; l’icône est téléchargée depuis l’URL et enregistrée avec l’identifiant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ID è univoco. Importando un workflow con lo stesso ID e una versione superiore, questo viene sostituito; l’icona viene scaricata dall’URL e memorizzata con l’ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID は一意です。同じ ID でより新しいバージョンのワークフローを読み込むと、このワークフローが置き換えられます。アイコンの URL はダウンロードされ、ID ごとに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID는 고유합니다. 같은 ID에 더 높은 버전의 워크플로를 가져오면 이 워크플로가 대치됩니다. 아이콘 URL은 다운로드되어 ID별로 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ID is uniek. Als je een workflow met dezelfde ID en een hogere versie importeert, wordt deze vervangen; de symbool-URL wordt gedownload en bij de ID bewaard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID 唯一。导入相同 ID 且版本更高的工作流会替换此工作流；图标 URL 会被下载并按 ID 存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID 是唯一的。匯入相同 ID 且版本較高的工作流程會取代此工作流程；圖像 URL 會被下載並依 ID 儲存。"
          }
        }
      }
    },
    "The panel lists your workflows and apps. ↩ runs or opens, ⌘1–⌘0 picks a row, ⌘↩ edits the workflow here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Panel listet deine Workflows und Apps. ↩ führt aus oder öffnet, ⌘1–⌘0 wählt eine Zeile, ⌘↩ bearbeitet den Workflow hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel muestra tus flujos de trabajo y apps. ↩ ejecuta o abre, ⌘1–⌘0 elige una fila, ⌘↩ edita el flujo de trabajo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le panneau liste vos flux de travail et vos apps. ↩ exécute ou ouvre, ⌘1–⌘0 choisit une ligne, ⌘↩ modifie le flux de travail ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pannello elenca i tuoi flussi di lavoro e le app. ↩ esegue o apre, ⌘1–⌘0 sceglie una riga, ⌘↩ modifica il flusso di lavoro qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネルにはワークフローとアプリが表示されます。↩ で実行または開く、⌘1〜⌘0 で行を選択、⌘↩ でここでワークフローを編集します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패널에 워크플로와 앱이 나열됩니다. ↩는 실행하거나 열고, ⌘1–⌘0은 행을 선택하며, ⌘↩는 여기에서 워크플로를 편집합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het paneel toont je workflows en apps. ↩ voert uit of opent, ⌘1–⌘0 kiest een rij, ⌘↩ wijzigt de workflow hier."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板会列出你的工作流和 App。↩ 运行或打开，⌘1–⌘0 选择对应行，⌘↩ 在此编辑工作流。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
