{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” %@ is older than the installed %@ and was skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ %2$@ ist älter als die installierte Version %3$@ und wurde übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” %2$@ es anterior a la versión instalada %3$@ y se ha omitido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » %2$@ est plus ancien que la version installée %3$@ et a été ignoré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” %2$@ è precedente alla versione installata %3$@ ed è stato saltato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」%2$@ はインストール済みの %3$@ より古いため、スキップしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ %2$@은(는) 설치된 %3$@보다 이전 버전이므로 건너뛰었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ %2$@ is ouder dan de geïnstalleerde versie %3$@ en is overgeslagen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” %2$@ 比已安装的 %3$@ 旧，已跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」%2$@ 比已安裝的 %3$@ 舊，已略過。"
          }
        }
      }
    },
    "“%@” uses the id of a built-in workflow and was skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verwendet die ID eines integrierten Workflows und wurde übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» usa el ID de un flujo de trabajo integrado y se omitió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » utilise l’identifiant d’un flux de travail intégré et a été ignoré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” usa l’ID di un flusso di lavoro integrato ed è stato saltato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”は内蔵ワークフローの ID を使っているためスキップしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 내장 워크플로의 ID를 사용하므로 건너뛰었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ gebruikt de ID van een ingebouwde workflow en is overgeslagen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”使用了内置工作流的 ID，已跳过。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」使用了內建工作流程的 ID，已略過。"
          }
        }
      }
    },
    "{{input}} is replaced by the argument (URL-encoded)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} wird durch das Argument ersetzt (URL-kodiert)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} se sustituye por el argumento (codificado para URL)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} est remplacé par l’argument (encodé pour l’URL)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} viene sostituito dall’argomento (codificato per URL)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} は引数（URL エンコード済み）に置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}}은 인수(URL 인코딩)로 대치됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} wordt vervangen door het argument (URL-gecodeerd)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} 会被替换为参数（已进行 URL 编码）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{input}} 會被取代為參數（已進行 URL 編碼）。"
          }
        }
      }
    },
    "{{output}} is replaced by the final output, {{error}} by the error. Runs started from Settings show the result window instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} wird durch die endgültige Ausgabe ersetzt, {{error}} durch den Fehler. Bei Ausführung aus den Einstellungen erscheint stattdessen das Ergebnisfenster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} se sustituye por la salida final y {{error}} por el error. Las ejecuciones iniciadas desde Ajustes muestran la ventana de resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} est remplacé par la sortie finale, {{error}} par l’erreur. Les exécutions lancées depuis les Réglages affichent plutôt la fenêtre de résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} viene sostituito dall’output finale, {{error}} dall’errore. Le esecuzioni avviate dalle Impostazioni mostrano invece la finestra dei risultati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} は最終出力に、{{error}} はエラーに置き換えられます。設定から実行した場合は、代わりに結果ウインドウが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}}은 최종 출력으로, {{error}}는 오류로 대체됩니다. 설정에서 실행하면 대신 결과 윈도우가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} wordt vervangen door de uiteindelijke uitvoer, {{error}} door de fout. Bij uitvoeren vanuit Instellingen verschijnt in plaats daarvan het resultaatvenster."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} 会替换为最终输出，{{error}} 会替换为错误信息。从设置中运行时会改为显示结果窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{output}} 會取代為最終輸出，{{error}} 會取代為錯誤訊息。從設定中執行時會改為顯示結果視窗。"
          }
        }
      }
    },
