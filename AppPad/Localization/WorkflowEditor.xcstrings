    "Built-in workflows are updated with AppPad and can’t be edited or deleted. Duplicate one to make your own version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrierte Workflows werden mit AppPad aktualisiert und können nicht bearbeitet oder gelöscht werden. Dupliziere einen, um eine eigene Version zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los flujos de trabajo integrados se actualizan con AppPad y no se pueden editar ni eliminar. Duplica uno para crear tu propia versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les workflows intégrés sont mis à jour avec AppPad et ne peuvent être ni modifiés ni supprimés. Dupliquez-en un pour créer votre propre version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I workflow integrati si aggiornano con AppPad e non possono essere modificati né eliminati. Duplicane uno per creare la tua versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵ワークフローは AppPad と一緒にアップデートされ、編集や削除はできません。自分用に変えたい場合は複製してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 워크플로는 AppPad와 함께 업데이트되며 편집하거나 삭제할 수 없습니다. 직접 바꾸려면 복제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingebouwde workflows worden met AppPad bijgewerkt en kunnen niet worden gewijzigd of verwijderd. Dupliceer er een om je eigen versie te maken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置工作流随 AppPad 更新，不能编辑或删除。想改成自己的版本，请复制一份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建工作流程隨 AppPad 更新，不能編輯或刪除。想改成自己的版本，請複製一份。"
          }
        }
      }
    },
