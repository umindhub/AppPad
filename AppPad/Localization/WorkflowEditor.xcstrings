    },
    "Scripts run in a sandbox with only the permissions you grant." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte laufen in einer Sandbox und haben nur die Berechtigungen, die du erteilst."
