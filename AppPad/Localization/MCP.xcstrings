    "Review the steps below. AppPad still asks for permissions the first time a workflow runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe die Schritte unten. AppPad fragt beim ersten Ausführen eines Workflows weiterhin nach Berechtigungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los pasos de abajo. AppPad seguirá pidiendo permisos la primera vez que se ejecute un flujo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les étapes ci-dessous. AppPad demande toujours les autorisations lors de la première exécution d’un flux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla i passaggi qui sotto. AppPad chiede comunque i permessi alla prima esecuzione di un flusso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の手順を確認してください。ワークフローを初めて実行するときは、引き続き AppPad が権限を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 단계를 검토하세요. 워크플로를 처음 실행할 때 AppPad가 여전히 권한을 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
