    "Shows the app, its developer and where it comes from before anything changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die App, ihren Entwickler und ihre Herkunft, bevor sich etwas ändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la app, su desarrollador y su procedencia antes de cambiar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
