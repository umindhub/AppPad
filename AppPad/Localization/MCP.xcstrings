    "Uninstalling an app with Homebrew deletes it right away instead of moving it to the Trash, so work may be lost (it cannot be restored)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Deinstallieren mit Homebrew wird die App sofort gelöscht statt in den Papierkorb gelegt, dabei kann Arbeit verloren gehen (sie lässt sich nicht wiederherstellen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desinstalar una app con Homebrew se borra directamente en lugar de ir a la papelera, por lo que puedes perder trabajo (no se puede recuperar)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désinstaller une app avec Homebrew la supprime directement au lieu de la placer dans la corbeille : du travail peut être perdu (impossible à restaurer)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disinstallare un’app con Homebrew la elimina subito invece di spostarla nel Cestino, quindi potresti perdere del lavoro (non recuperabile)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrewでアプリをアンインストールすると、ゴミ箱に入らずすぐに削除されるため、作業内容が失われることがあります（元に戻せません）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew로 앱을 제거하면 휴지통으로 이동되지 않고 바로 삭제되므로 작업 내용이 사라질 수 있습니다(복구할 수 없음)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een app verwijderen met Homebrew wist hem meteen in plaats van hem naar de prullenmand te verplaatsen, waardoor werk verloren kan gaan (niet te herstellen)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Homebrew 卸载 App 会直接删除，不会移到废纸篓，可能会丢失工作内容（无法恢复）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 Homebrew 解除安裝 App 會直接刪除，不會丟到垃圾桶，可能會遺失工作內容（無法復原）。"
          }
        }
      }
    },
