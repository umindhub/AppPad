    "This download has no fixed checksum: Homebrew installs the version the website currently offers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Download hat keine feste Prüfsumme: Homebrew installiert die Version, die die Website gerade anbietet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta descarga no tiene una suma de verificación fija: Homebrew instala la versión que ofrece el sitio web en este momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléchargement n’a pas de somme de contrôle fixe : Homebrew installe la version actuellement proposée par le site."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo download non ha un checksum fisso: Homebrew installa la versione offerta al momento dal sito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このダウンロードには固定のチェックサムがありません。Homebrewは、Webサイトが現在提供しているバージョンをインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 다운로드에는 고정된 체크섬이 없습니다. Homebrew는 웹사이트가 현재 제공하는 버전을 설치합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze download heeft geen vaste checksum: Homebrew installeert de versie die de website op dit moment aanbiedt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此下载没有固定的校验和：Homebrew 会安装官网当前提供的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此下載沒有固定的檢查碼：Homebrew 會安裝官網目前提供的版本。"
          }
        }
      }
    },
    "Turn confirmation back on unless you watch every AI request yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte die Bestätigung wieder ein, es sei denn, du verfolgst jede KI-Anfrage selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a activar la confirmación, salvo que vigiles tú mismo cada petición de la IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réactivez la confirmation, sauf si vous surveillez vous-même chaque demande de l’IA."
          }
        },
        "it" : {
